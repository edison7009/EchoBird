{
  "name": "echobird",
  "version": "6.4.9",
  "description": "All-in-one AI desktop app with one-click installs for Claude Code, Codex CLI, DeepSeek and more. Manage AI accounts and quotas, route models with automatic failover, use voice input, and run local LLMs. Grow a Token Pet as you use AI.",
  "author": "Echo Bird Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run website:dev",
    "build": "npm run website:build",
    "test": "node --test website/*.test.mjs scripts/tests/website_download.test.mjs scripts/tests/release_notes.test.mjs",
    "postinstall": "patch-package --error-on-fail",
    "website:dev": "vite --config website/vite.config.ts",
    "website:build": "vite build --config website/vite.config.ts && node scripts/prepare-website.mjs",
    "website:test": "node --test website/*.test.mjs scripts/tests/website_download.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "18.3.0",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "lucide-react": "^1.14.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.38",
    "prettier": "3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vite": "^6.4.6",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
