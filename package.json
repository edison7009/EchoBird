{
  "name": "echobird",
  "version": "6.2.9",
  "description": "AI Model & Skill Management Desktop Application",
  "author": "Echo Bird Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run tauri -- dev",
    "build": "npm run tauri -- build",
    "tauri": "npx --yes @tauri-apps/cli@2.12.4",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests && node --test scripts/tests/website_download.test.mjs scripts/tests/plugin_sdk.test.mjs scripts/tests/usage_island_styles.test.mjs scripts/tests/dependency_patches.test.mjs scripts/tests/catalogs.test.mjs scripts/tests/release_notes.test.mjs && node scripts/sync-catalogs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "copy:config": "echo no-op",
    "postinstall": "patch-package --error-on-fail && node scripts/verify-dependency-patches.mjs && node scripts/sync-catalogs.mjs",
    "catalog:generate": "node scripts/sync-catalogs.mjs --write && prettier --write \"src/data/*.json\"",
    "catalog:check": "node scripts/sync-catalogs.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kongyo2/cards-css": "0.5.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5",
    "three": "0.180.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "18.3.0",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "lucide-react": "^1.14.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
